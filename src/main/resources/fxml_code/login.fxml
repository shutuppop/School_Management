<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.schoolmanagement.controller.LoginController"
            prefHeight="400.0" prefWidth="600.0"
            stylesheets="/css_code/login_style.css">
    <VBox alignment="CENTER" spacing="20.0" styleClass="root-container" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40" />
        </padding>
        <VBox alignment="CENTER" spacing="10.0">
            <Text text="📚 Школьный дневник" styleClass="main-title"/>
            <Text text="Вход в систему" styleClass="subtitle"/>
        </VBox>
        <VBox alignment="CENTER" spacing="15.0" maxWidth="350.0">
            <VBox spacing="5.0">
                <Text text="Email" styleClass="field-label"/>
                <TextField fx:id="emailField"
                           promptText="example@mail.com"
                           styleClass="input-field"/>
            </VBox>
            <VBox spacing="5.0">
                <Text text="Пароль" styleClass="field-label"/>
                <PasswordField fx:id="passwordField"
                               promptText="••••••••"
                               styleClass="input-field"/>
            </VBox>
            <Button fx:id="loginButton"
                    text="Войти"
                    styleClass="login-button"
                    onAction="#handleLogin"/>
            <HBox alignment="CENTER" spacing="10.0">
                <Separator styleClass="separator" HBox.hgrow="ALWAYS"/>
                <Text text="или" styleClass="separator-text"/>
                <Separator styleClass="separator" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Button fx:id="registerButton"
                    text="Зарегистрироваться"
                    styleClass="register-button"
                    onAction="#handleRegister"/>
            <Label fx:id="errorLabel"
                   text=""
                   styleClass="error-label"
                   wrapText="true"
                   alignment="CENTER"
                   maxWidth="300.0"
                   visible="false"/>
        </VBox>
    </VBox>
</AnchorPane>